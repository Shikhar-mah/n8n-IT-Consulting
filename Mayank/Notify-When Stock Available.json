        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 650px; margin: auto; padding: 20px; border: 1px solid #e5e7eb; border-radius: 10px;\">\n  \n  <h2 style=\"color: #16a34a; margin-bottom: 5px;\">✅ Stock Available Now</h2>\n  <p style=\"font-size: 14px; color: #374151; margin-top: 0;\">\n    Hello <b>{{$node[\"Keep Request Data\"].json[\"user_name\"]}}</b>,\n  </p>\n\n  <p style=\"font-size: 14px; color: #374151;\">\n    Good news! The laptop stock you requested is now available. You can submit your request again to proceed with allocation.\n  </p>\n\n  <div style=\"background: #f9fafb; padding: 15px; border-radius: 8px; border: 1px solid #e5e7eb;\">\n    <h3 style=\"margin-top: 0; color: #111827;\">📌 Request Details</h3>\n    <p style=\"margin: 6px 0; font-size: 14px;\"><b>User Name:</b> {{$node[\"Keep Request Data\"].json[\"user_name\"]}}</p>\n    <p style=\"margin: 6px 0; font-size: 14px;\"><b>User Email:</b> {{$node[\"Keep Request Data\"].json[\"user_email\"]}}</p>\n    <p style=\"margin: 6px 0; font-size: 14px;\"><b>Laptop Type:</b> {{$node[\"Keep Request Data\"].json[\"laptop_type\"]}}</p>\n  </div>\n\n  <p style=\"font-size: 14px; color: #374151; margin-top: 18px;\">\n    <b>Next Step:</b> Please submit the laptop request form again so the system can allocate the device(s).\n  </p>\n\n  <p style=\"font-size: 14px; color: #6b7280;\">\n    If you no longer require the laptop, you may ignore this email.\n  </p>\n\n  <hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;\" />\n\n  <p style=\"font-size: 13px; color: #6b7280; margin-bottom: 0;\">\n    Regards,<br>\n    <b>IT Support Team</b><br>\n    BlueAltair IT Operations\n  </p>\n\n</div>\n\n",
        "options": {}
