    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.issue_text }}{{ $json.problems }}",
        "options": {
          "systemMessage": "=You are an IT support improvement agent. You are an expert at detecting similarities between different issues related to laptops. \n\nYour task is to check if {{ $json.issue_text }} is similar to any entries in here [ {{ $json.problems }} ] and then decide the following\n\nDecide:\n1) Is this a recurring issue? (true/false; has something similar happened previously? read all and decide)\n2) Should knowledge base be updated? (true/false; if the recurring is false then the knowledge base needs to be update hence it has to be true, otherwise false it will be false)\n\nRespond strictly in JSON format:\n{\n    \"recurring\": true/false,\n    \"kb_update_required\": true/false           \n}\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -1008,
        144
      ],
      "id": "0a4052eb-df5d-4b96-aef4-915a63bdf6ca",
      "name": "Check similarity"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "knowledge_base",
        "returnAll": true,
        "matchType": "allFilters"
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -1456,
        256
      ],
      "id": "b3a75e60-ff82-4f55-9523-930be1f429d0",
      "name": "Get many rows",
      "credentials": {
        "supabaseApi": {
          "id": "YhhYiwQkQAmkNf3U",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Add a new field called 'myNewField' to the JSON of the item\n// Get all incoming items\nconst items = $input.all();\n\nlet issueText = $('Update_Ticket_info').first().json.issue_text;\n// let issueText = $('Update a row').first().json.issue_text;\nlet problems = [];\n\n// Loop through all inputs\nfor (const item of items) {\n  const data = item.json;\n\n  // From \"Update Ticket info\" node\n  if (data.issue_text) {\n    issueText = data.issue_text;\n  }\n\n  // From \"Get many rows\" node\n  if (data.problem) {\n    problems.push(data.problem);\n  }\n}\n\n// Return combined result\nreturn [\n  {\n    json: {\n      issue_text: issueText,\n      problems: problems\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1232,
        256
      ],
      "id": "95565987-460b-4a23-8514-a5053506b4ea",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Get raw AI output\nlet text = item.output || \"\";\n\n// Remove markdown ```json and ```\ntext = text\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .replace(/^[^{]*\\{/s, \"{\")\n  .replace(/\\}[^}]*$/s, \"}\")\n  .trim();\n\n// Parse cleaned JSON safely\nlet aiData = {};\ntry {\n  aiData = JSON.parse(text);\n} catch (e) {\n  throw new Error(\"Invalid AI JSON: \" + text);\n}\n\n// Generate ticket ID only if ticket required\nlet ticketId = null;\nif (aiData.create_ticket === \"Yes\") {\n  const randomNum = Math.floor(1000 + Math.random() * 9000);\n  ticketId = `TCKT-${randomNum}`;\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n\n      // AI fields\n      // create_ticket: aiData.create_ticket,\n      knowledge_base_update_required: aiData.kb_update_required,\n\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        256
      ],
      "id": "edea9055-e6cb-48b3-ad1b-38e1e678ea82",
      "name": "Code in JavaScript1"
    },
