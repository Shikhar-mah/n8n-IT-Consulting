    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Get raw AI output\nlet text = item.output || \"\";\n\n// Remove markdown ```json and ```\ntext = text\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .replace(/^[^{]*\\{/s, \"{\")\n  .replace(/\\}[^}]*$/s, \"}\")\n  .trim();\n\n// Parse cleaned JSON safely\nlet aiData = {};\ntry {\n  aiData = JSON.parse(text);\n} catch (e) {\n  throw new Error(\"Invalid AI JSON: \" + text);\n}\n\n// Generate ticket ID only if ticket required\nlet ticketId = null;\nif (aiData.create_ticket === \"Yes\") {\n  const randomNum = Math.floor(1000 + Math.random() * 9000);\n  ticketId = `TCKT-${randomNum}`;\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n\n      // AI fields\n      create_ticket: aiData.create_ticket,\n      severity: aiData.severity,\n\n      // System fields\n      ticket_id: ticketId,\n      status: aiData.create_ticket === \"Yes\" ? \"Open\" : \"Closed\",\n      created_at: new Date().toISOString(),\n      resolved_at: null,\n      feedback_rating: null,\n      feedback_comment: null\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -784,
        -96
      ],
      "id": "c0446b2e-b542-4979-af64-902a91f9f937",
      "name": "Ticket-Generation"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Get webhook body\nconst body = item.body || {};\n\n// Clean AI output\nlet text = item.output || \"\";\n\ntext = text\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .replace(/^[^{]*\\{/s, \"{\")\n  .replace(/\\}[^}]*$/s, \"}\")\n  .trim();\n\n// Parse AI JSON\nlet aiData = {};\ntry {\n  aiData = JSON.parse(text);\n} catch (e) {\n  throw new Error(\"Invalid AI JSON: \" + text);\n}\n\n// Build clean final object\nreturn [\n  {\n    json: {\n      // From webhook\n      employee_name: body.employee_name || null,\n      employee_email: body.employee_email || null,\n      issue_text: body.issue_text || null,\n      ai_category: body.ai_category || null,\n      ai_steps: body.ai_steps || null,\n      ticket_id: $input.first().json.ticket_id || null,\n\n      // From AI\n      create_ticket: aiData.create_ticket || null,\n      severity: aiData.severity || null,\n      assigned_team: aiData.assigned_team || null,\n\n      // System fields\n      status:\n        aiData.create_ticket === \"Yes\" ? \"Open\" : \"Closed\",\n\n      created_at: item.created_at || new Date().toISOString(),\n      resolved_at: item.resolved_at || null,\n      feedback_rating: item.feedback_rating || null,\n      feedback_comment: item.feedback_comment || null\n    }\n  }\n];\n"
      },
